# Copy this file to .env and fill in your values.
# The app loads these automatically via pydantic-settings.

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Get this from: Azure portal → Storage Account → Access keys → Connection string
# Or: az storage account show-connection-string --name <SA_NAME> --resource-group <RG>
AZURE_STORAGE_CONNECTION_STRING=

# The blob container name (created by the provisioning script below)
AZURE_STORAGE_CONTAINER=models

# ── Azure ML (optional — only needed for MLflow / model registry integration) ─
AZURE_ML_WORKSPACE=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_SUBSCRIPTION_ID=

# ── Model artifact names (must match what was saved) ─────────────────────────
REGRESSION_MODEL_NAME=regression
CLASSIFICATION_MODEL_NAME=classification

# ── Local fallback: training from CSV when no pre-trained model is available ──
# Set these if you want the API to train on startup instead of loading a blob
TRAIN_DATA_PATH=
TEST_DATA_PATH=

# ── Local model cache directory (joblib files) ───────────────────────────────
MODEL_DIR=models

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── MLflow experiment tracking ────────────────────────────────────────────────
# Set MLFLOW_ENABLED=true to activate tracking. All other fields are optional.
MLFLOW_ENABLED=false

# Where MLflow stores runs.
# Leave empty → sqlite:///mlflow.db (local SQLite, zero setup).
# Azure ML → azureml://<region>.api.azureml.ms/mlflow/v1.0/subscriptions/<sub>/...
MLFLOW_TRACKING_URI=

# Experiment names (created automatically on first run)
MLFLOW_EXPERIMENT_REGRESSION=house-price-regression
MLFLOW_EXPERIMENT_CLASSIFICATION=house-type-classification

# Set true to promote models to the Model Registry after training.
# Regression is registered only if r2 >= MLFLOW_R2_THRESHOLD.
# Classification is registered only if weighted_f1 >= MLFLOW_F1_THRESHOLD.
MLFLOW_REGISTER_MODELS=false
MLFLOW_R2_THRESHOLD=0.70
MLFLOW_F1_THRESHOLD=0.80
